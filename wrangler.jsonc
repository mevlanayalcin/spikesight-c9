{
  "name": "spikesight-c9",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "COACH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
